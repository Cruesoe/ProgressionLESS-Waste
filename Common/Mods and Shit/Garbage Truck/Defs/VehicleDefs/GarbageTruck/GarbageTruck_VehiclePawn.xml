			<drawSize>(4,7)</drawSize>
			<color>(130, 146, 122)</color> <!-- RGB value for default color -->
			<colorTwo>(79, 69, 60)</colorTwo>
			<colorThree>(79, 163, 37)</colorThree>
			<tiles>1</tiles>
			<displacement>(0, 0.13)</displacement>
