<?xml version="1.0" encoding="utf-8" ?>
<Defs>
	<ThingDef ParentName="AdaptiveStorageBase">
        <defName>FernyTrashBin</defName>
		<label>trash bin</label>
		<graphicData>
			<texPath>Things/Other/Bin_Small</texPath>
			<graphicClass>Graphic_Single</graphicClass>
      		<drawSize>(1,1)</drawSize>
			<drawRotated>false</drawRotated>
			<color>(255,255,255)</color>
		</graphicData>
		<description>A compact, cylindrical container designed for everyday waste disposal around the colony. Perfect for quickly storing trash. \n\n&lt;color=#E5E54C&gt;Storage stats:&lt;/color&gt; 
Stack size total: 8 
Stack per tile: 8 

Allowed items: Trash</description>
		<fillPercent>0.30</fillPercent>
		<uiIconScale>0.7</uiIconScale>
		<size>(1,1)</size>
        <rotatable>false</rotatable>
        <defaultPlacingRot>East</defaultPlacingRot>
        <researchPrerequisites>
            <li>MF_WasteDisposal</li>
        </researchPrerequisites>
		<statBases>
			<MaxHitPoints>50</MaxHitPoints>
			<WorkToBuild>300</WorkToBuild>
			<Beauty>0</Beauty>
			<Mass>1</Mass>
            <Flammability>1</Flammability>
		</statBases>
        <stuffCategories>
			<li>Woody</li>
			<li>Metallic</li>
			<li>Stony</li>
		</stuffCategories>
		<costStuffCount>90</costStuffCount>
		<building>
			<preventDeteriorationOnTop>true</preventDeteriorationOnTop>
            <ignoreStoredThingsBeauty>true</ignoreStoredThingsBeauty>
			<maxItemsInCell>8</maxItemsInCell>
			<fixedStorageSettings>
				<filter>
					<thingDefs>  
						<li>VRecyclingE_Trash</li>
					</thingDefs>
				</filter>
			</fixedStorageSettings>
			<paintable>true</paintable>
		</building>
		<minifiedDef>MinifiedThing</minifiedDef>
		<thingCategories>
			<li>BuildingsFurniture</li>
		</thingCategories>
	</ThingDef>
</Defs>